<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Pantalla principal -->
    <LinearLayout
        android:id="@+id/root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingHorizontal="16dp">

        <!-- Barra superior -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="64dp"
            android:gravity="center_vertical" android:orientation="horizontal">
            <FrameLayout android:layout_width="48dp" android:layout_height="48dp" android:layout_marginStart="-8dp">
                <ImageView android:id="@+id/btnMenu" android:layout_width="48dp" android:layout_height="48dp"
                    android:contentDescription="Menú" android:padding="12dp" android:src="@drawable/ic_menu" />
                <View android:id="@+id/dotUpd" android:layout_width="8dp" android:layout_height="8dp"
                    android:layout_gravity="top|end" android:layout_margin="10dp" android:visibility="gone" />
            </FrameLayout>
            <TextView android:id="@+id/txtTitulo" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_marginStart="4dp" android:layout_weight="1" android:ellipsize="end" android:maxLines="1"
                android:text="BLERemoteVESC" android:textSize="22sp" />
            <LinearLayout android:id="@+id/chipLink" android:layout_width="wrap_content" android:layout_height="32dp"
                android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="8dp" android:paddingEnd="12dp">
                <ImageView android:id="@+id/icLink" android:layout_width="18dp" android:layout_height="18dp"
                    android:layout_marginEnd="6dp" android:src="@drawable/ic_bt_off" android:importantForAccessibility="no" />
                <TextView android:id="@+id/txtLink" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Sin conexión" android:textSize="14sp" android:fontFamily="sans-serif-medium" />
            </LinearLayout>
        </LinearLayout>

        <!-- Modos de potencia: boton segmentado M3 -->
        <LinearLayout android:id="@+id/modosPot" style="@style/Seg" android:layout_marginTop="4dp" android:layout_marginBottom="16dp">
            <TextView android:id="@+id/mpEco" style="@style/SegBtn" android:text="Eco" />
            <View android:id="@+id/mpDiv1" android:layout_width="1dp" android:layout_height="match_parent" />
            <TextView android:id="@+id/mpCrucero" style="@style/SegBtn" android:text="Crucero" />
            <View android:id="@+id/mpDiv2" android:layout_width="1dp" android:layout_height="match_parent" />
            <TextView android:id="@+id/mpSport" style="@style/SegBtn" android:text="Sport" />
        </LinearLayout>

        <!-- Cuerpo: tarjetas a los lados, acelerador en el centro -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
            android:orientation="horizontal" android:paddingBottom="16dp">

            <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
                android:gravity="center_vertical" android:orientation="vertical">
                <LinearLayout android:id="@+id/cardBat" style="@style/Card">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                        <ImageView android:id="@+id/icBat" android:layout_width="18dp" android:layout_height="18dp" android:layout_marginEnd="6dp" android:src="@drawable/ic_battery" android:importantForAccessibility="no" />
                        <TextView android:id="@+id/lblBat" style="@style/CardLbl" android:text="Batería" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
                        <TextView android:id="@+id/txtBat" style="@style/Num" android:text="--" android:textSize="40sp" />
                        <TextView android:id="@+id/uBat" style="@style/Unit" android:text="%" />
                    </LinearLayout>
                    <ProgressBar android:id="@+id/barBat" style="@android:style/Widget.ProgressBar.Horizontal"
                        android:layout_width="match_parent" android:layout_height="4dp" android:layout_marginTop="10dp"
                        android:max="100" android:progress="0" />
                    <TextView android:id="@+id/txtVolt" style="@style/Sup" android:text="Sin datos" />
                    <TextView android:id="@+id/txtAutonomia" style="@style/Sup" android:text="" />
                </LinearLayout>
                <LinearLayout android:id="@+id/cardRumbo" style="@style/Card" android:layout_marginTop="12dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                        <ImageView android:id="@+id/icRumbo" android:layout_width="18dp" android:layout_height="18dp" android:layout_marginEnd="6dp" android:src="@drawable/ic_explore" android:importantForAccessibility="no" />
                        <TextView android:id="@+id/lblRumbo" style="@style/CardLbl" android:text="Rumbo" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"
                        android:gravity="center_vertical" android:orientation="horizontal">
                        <xyz.danilab.bleremotevesc.CompassView android:id="@+id/compass" android:layout_width="44dp" android:layout_height="44dp"
                            android:layout_marginEnd="10dp" />
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                            <TextView android:id="@+id/txtRumbo" style="@style/Num" android:layout_marginTop="0dp" android:text="--" android:textSize="26sp" />
                            <TextView android:id="@+id/txtRumboSub" style="@style/Sup" android:layout_marginTop="2dp" android:text="" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <xyz.danilab.bleremotevesc.ThrottleView
                android:id="@+id/throttle"
                android:layout_width="112dp"
                android:layout_height="match_parent"
                android:layout_marginHorizontal="12dp" />

            <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
                android:gravity="center_vertical" android:orientation="vertical">
                <LinearLayout android:id="@+id/cardCmd" style="@style/Card">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                        <ImageView android:id="@+id/icCmd" android:layout_width="18dp" android:layout_height="18dp" android:layout_marginEnd="6dp" android:src="@drawable/ic_speed" android:importantForAccessibility="no" />
                        <TextView android:id="@+id/lblCmd" style="@style/CardLbl" android:text="Acelerador" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
                        <TextView android:id="@+id/txtCmd" style="@style/Num" android:text="0" android:textSize="28sp" />
                        <TextView android:id="@+id/uCmd" style="@style/Unit" android:text="%" />
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout android:id="@+id/cardPow" style="@style/Card" android:layout_marginTop="12dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                        <ImageView android:id="@+id/icPow" android:layout_width="18dp" android:layout_height="18dp" android:layout_marginEnd="6dp" android:src="@drawable/ic_bolt" android:importantForAccessibility="no" />
                        <TextView android:id="@+id/lblPow" style="@style/CardLbl" android:text="Potencia" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
                        <TextView android:id="@+id/txtPow" style="@style/Num" android:text="--" android:textSize="28sp" />
                        <TextView android:id="@+id/uPow" style="@style/Unit" android:text="W" />
                    </LinearLayout>
                    <TextView android:id="@+id/txtAmpBat" style="@style/Sup" android:text="Sin datos" />
                </LinearLayout>
                <LinearLayout android:id="@+id/cardSpd" style="@style/Card" android:layout_marginTop="12dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                        <ImageView android:id="@+id/icSpd" android:layout_width="18dp" android:layout_height="18dp" android:layout_marginEnd="6dp" android:src="@drawable/ic_near_me" android:importantForAccessibility="no" />
                        <TextView android:id="@+id/lblSpd" style="@style/CardLbl" android:text="Velocidad" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
                        <TextView android:id="@+id/txtVelocidad" style="@style/Num" android:text="--" android:textSize="28sp" />
                        <TextView android:id="@+id/uSpd" style="@style/Unit" android:text="km/h" />
                    </LinearLayout>
                    <TextView android:id="@+id/txtFixGps" style="@style/Sup" android:text="Esperando GPS" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Parar motor -->
        <LinearLayout android:id="@+id/btnParada" android:layout_width="match_parent" android:layout_height="64dp"
            android:layout_marginBottom="16dp" android:gravity="center" android:orientation="horizontal"
            android:clickable="true" android:focusable="true" android:contentDescription="Parar motor">
            <ImageView android:id="@+id/icStop" android:layout_width="26dp" android:layout_height="26dp"
                android:layout_marginEnd="8dp" android:src="@drawable/ic_stop" android:importantForAccessibility="no" />
            <TextView android:id="@+id/txtStop" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium" android:text="Parar motor" android:textSize="18sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Menu lateral -->
    <ScrollView android:id="@+id/panel" android:layout_width="340dp" android:layout_height="match_parent" android:layout_gravity="start">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
            android:paddingHorizontal="12dp" android:paddingTop="16dp" android:paddingBottom="28dp">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical"
                android:orientation="horizontal" android:padding="12dp">
                <ImageView android:id="@+id/pIcon" android:layout_width="40dp" android:layout_height="40dp"
                    android:layout_marginEnd="12dp" android:contentDescription="BLERemoteVESC" android:src="@mipmap/ic_launcher" />
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical">
                    <TextView android:id="@+id/pTitle" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium" android:text="BLERemoteVESC" android:textSize="18sp" />
                    <TextView android:id="@+id/pVersion" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Conexion, siempre visible -->
            <LinearLayout android:id="@+id/cardConn" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginHorizontal="4dp" android:layout_marginBottom="12dp" android:orientation="vertical" android:padding="16dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical"
                    android:orientation="horizontal" android:layout_marginBottom="12dp">
                    <ImageView android:id="@+id/icConn" android:layout_width="24dp" android:layout_height="24dp"
                        android:layout_marginEnd="12dp" android:src="@drawable/ic_bt_off" android:importantForAccessibility="no" />
                    <TextView android:id="@+id/txtEstado" android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="Desconectado" android:textSize="16sp" />
                </LinearLayout>
                <TextView android:id="@+id/btnConectar" style="@style/Btn" android:layout_marginTop="0dp" android:text="Conectar" />
                <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/swPitido"
                    android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp"
                    android:text="Pitido del motor al conectar" android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout android:id="@+id/hApariencia" style="@style/Item">
                <ImageView android:id="@+id/iApariencia" style="@style/ItemIcon" android:src="@drawable/ic_palette" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:id="@+id/tApariencia" style="@style/ItemTitle" android:text="Apariencia" />
                    <TextView android:id="@+id/uApariencia" style="@style/ItemSub" android:text="Claro, oscuro o AMOLED" />
                </LinearLayout>
                <ImageView android:id="@+id/cApariencia" android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_expand" android:importantForAccessibility="no" />
            </LinearLayout>
            <LinearLayout android:id="@+id/bApariencia" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:paddingStart="56dp" android:paddingEnd="16dp" android:paddingBottom="12dp" android:visibility="gone">
                <LinearLayout android:id="@+id/seg" style="@style/Seg">
                    <TextView android:id="@+id/mClaro" style="@style/SegBtn" android:text="Claro" />
                    <View android:id="@+id/segDiv1" android:layout_width="1dp" android:layout_height="match_parent" />
                    <TextView android:id="@+id/mOscuro" style="@style/SegBtn" android:text="Oscuro" />
                    <View android:id="@+id/segDiv2" android:layout_width="1dp" android:layout_height="match_parent" />
                    <TextView android:id="@+id/mAmoled" style="@style/SegBtn" android:text="AMOLED" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout android:id="@+id/hAcelerador" style="@style/Item">
                <ImageView android:id="@+id/iAcelerador" style="@style/ItemIcon" android:src="@drawable/ic_tune" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:id="@+id/tAcelerador" style="@style/ItemTitle" android:text="Acelerador" />
                    <TextView android:id="@+id/uAcelerador" style="@style/ItemSub" android:text="Tope, suavizado y curva" />
                </LinearLayout>
                <ImageView android:id="@+id/cAcelerador" android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_expand" android:importantForAccessibility="no" />
            </LinearLayout>
            <LinearLayout android:id="@+id/bAcelerador" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:paddingStart="56dp" android:paddingEnd="16dp" android:paddingBottom="12dp" android:visibility="gone">
                <TextView android:id="@+id/rModoHint" style="@style/Hint" android:text="El tope y el suavizado son del modo activo." />
                <TextView android:id="@+id/rMax" style="@style/Row" />
                <com.google.android.material.slider.Slider android:id="@+id/sMax" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:valueFrom="5" android:valueTo="50" android:stepSize="1"
                    android:value="12" app:labelBehavior="gone" />
                <TextView android:id="@+id/rRamp" style="@style/Row" />
                <com.google.android.material.slider.Slider android:id="@+id/sRamp" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:valueFrom="1" android:valueTo="20" android:stepSize="1"
                    android:value="10" app:labelBehavior="gone" />
                <TextView android:id="@+id/rRampHint" style="@style/Hint" android:text="Tiempo de 0 a 100 % aunque lleves la palanca al tope de golpe. Soltar gas siempre es inmediato." />
                <TextView android:id="@+id/rMin" style="@style/Row" />
                <com.google.android.material.slider.Slider android:id="@+id/sMin" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:valueFrom="0" android:valueTo="6" android:stepSize="0.5"
                    android:value="1.5" app:labelBehavior="gone" />
                <TextView android:id="@+id/rExp" style="@style/Row" />
                <com.google.android.material.slider.Slider android:id="@+id/sExp" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:valueFrom="1" android:valueTo="3" android:stepSize="0.1"
                    android:value="2" app:labelBehavior="gone" />
                <TextView android:id="@+id/rDz" style="@style/Row" />
                <com.google.android.material.slider.Slider android:id="@+id/sDz" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:valueFrom="2" android:valueTo="20" android:stepSize="1"
                    android:value="8" app:labelBehavior="gone" />
            </LinearLayout>

            <LinearLayout android:id="@+id/hBateria" style="@style/Item">
                <ImageView android:id="@+id/iBateria" style="@style/ItemIcon" android:src="@drawable/ic_battery_charging" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:id="@+id/tBateria" style="@style/ItemTitle" android:text="Batería" />
                    <TextView android:id="@+id/uBateria" style="@style/ItemSub" android:text="Corrección de tensión" />
                </LinearLayout>
                <ImageView android:id="@+id/cBateria" android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_expand" android:importantForAccessibility="no" />
            </LinearLayout>
            <LinearLayout android:id="@+id/bBateria" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:paddingStart="56dp" android:paddingEnd="16dp" android:paddingBottom="12dp" android:visibility="gone">
                <TextView android:id="@+id/rVoff" style="@style/Row" />
                <com.google.android.material.slider.Slider android:id="@+id/sVoff" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:valueFrom="-1.5" android:valueTo="1.5" android:stepSize="0.1"
                    android:value="0" app:labelBehavior="gone" />
                <TextView android:id="@+id/rVoffHint" style="@style/Hint" android:text="Ajústala hasta que coincida con la tensión que marca la app de la BMS." />
            </LinearLayout>

            <LinearLayout android:id="@+id/hAhorro" style="@style/Item">
                <ImageView android:id="@+id/iAhorro" style="@style/ItemIcon" android:src="@drawable/ic_leaf" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:id="@+id/tAhorro" style="@style/ItemTitle" android:text="Ahorro de batería" />
                    <TextView android:id="@+id/uAhorro" style="@style/ItemSub" android:text="Pantalla y GPS" />
                </LinearLayout>
                <ImageView android:id="@+id/cAhorro" android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_expand" android:importantForAccessibility="no" />
            </LinearLayout>
            <LinearLayout android:id="@+id/bAhorro" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:paddingStart="56dp" android:paddingEnd="16dp" android:paddingBottom="12dp" android:visibility="gone">
                <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/swAtenuar"
                    android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp"
                    android:text="Atenuar pantalla tras 30 s" android:textSize="14sp" />
                <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/swGps"
                    android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp"
                    android:text="Velocidad por GPS" android:textSize="14sp" />
                <TextView android:id="@+id/rEnergiaHint" style="@style/Hint" android:text="El GPS es lo que más gasta después de la pantalla." />
            </LinearLayout>

            <LinearLayout android:id="@+id/hSeguridad" style="@style/Item">
                <ImageView android:id="@+id/iSeguridad" style="@style/ItemIcon" android:src="@drawable/ic_shield" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:id="@+id/tSeguridad" style="@style/ItemTitle" android:text="Seguridad" />
                    <TextView android:id="@+id/uSeguridad" style="@style/ItemSub" android:text="Cortes automáticos" />
                </LinearLayout>
                <ImageView android:id="@+id/cSeguridad" android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_expand" android:importantForAccessibility="no" />
            </LinearLayout>
            <LinearLayout android:id="@+id/bSeguridad" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:paddingStart="56dp" android:paddingEnd="16dp" android:paddingBottom="12dp" android:visibility="gone">
                <TextView android:id="@+id/rSeg1" style="@style/Hint" android:text="Corte al perder enlace: 1,0 s (lo hace el VESC)." />
                <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/swCorte"
                    android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp"
                    android:text="Parar el motor al salir de la app" android:textSize="14sp" />
                <TextView android:id="@+id/rCorteHint" style="@style/Hint" android:text="" />
            </LinearLayout>

            <LinearLayout android:id="@+id/hUpd" style="@style/Item">
                <ImageView android:id="@+id/iUpd" style="@style/ItemIcon" android:src="@drawable/ic_update" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:id="@+id/tUpd" style="@style/ItemTitle" android:text="Actualizaciones" />
                    <TextView android:id="@+id/uUpd" style="@style/ItemSub" android:text="Buscar nuevas versiones" />
                </LinearLayout>
                <ImageView android:id="@+id/cUpd" android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_expand" android:importantForAccessibility="no" />
            </LinearLayout>
            <LinearLayout android:id="@+id/bUpd" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:paddingStart="56dp" android:paddingEnd="16dp" android:paddingBottom="12dp" android:visibility="gone">
                <TextView android:id="@+id/txtUpd" style="@style/Hint" android:text="Versión instalada" />
                <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/swAutoUpd"
                    android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp"
                    android:text="Buscar al abrir (cada 12 h)" android:textSize="14sp" />
                <TextView android:id="@+id/btnBuscarUpd" style="@style/Btn" android:text="Buscar actualizaciones" android:visibility="visible" />
                <TextView android:id="@+id/btnInstalarUpd" style="@style/Btn" android:text="Actualizar" android:visibility="gone" />
            </LinearLayout>

            <LinearLayout android:id="@+id/hAcerca" style="@style/Item">
                <ImageView android:id="@+id/iAcerca" style="@style/ItemIcon" android:src="@drawable/ic_info" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:id="@+id/tAcerca" style="@style/ItemTitle" android:text="Acerca de" />
                    <TextView android:id="@+id/uAcerca" style="@style/ItemSub" android:text="Daniel Acevedo" />
                </LinearLayout>
                <ImageView android:id="@+id/cAcerca" android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_expand" android:importantForAccessibility="no" />
            </LinearLayout>
            <LinearLayout android:id="@+id/bAcerca" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:paddingStart="56dp" android:paddingEnd="16dp" android:paddingBottom="12dp" android:visibility="gone">
                <TextView android:id="@+id/aNombre" style="@style/Row" android:text="BLERemoteVESC" android:textStyle="bold" />
                <TextView android:id="@+id/aDesc" style="@style/Hint" android:text="Mando Bluetooth para motores con controlador VESC, pensado para patos de pesca." />
                <TextView android:id="@+id/aAutor" style="@style/Row" android:layout_marginTop="10dp" android:text="Creado por Daniel Acevedo" />
                <TextView android:id="@+id/aWeb" style="@style/Row" android:minHeight="40dp" android:gravity="center_vertical" android:text="danilab.xyz" />
                <TextView android:id="@+id/aRepo" style="@style/Row" android:minHeight="40dp" android:gravity="center_vertical" android:text="github.com/Danii204/BLERemoteVESC" />
                <TextView android:id="@+id/aLic" style="@style/Hint" android:text="Software libre bajo licencia GPL-3.0. No recoge ni envía datos; solo consulta GitHub para buscar actualizaciones." />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</androidx.drawerlayout.widget.DrawerLayout>
